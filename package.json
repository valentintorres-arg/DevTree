{
  "name": "devtree",
  "private": true,
  "version": "0.0.0",
  "description": "Herramientas de repo-hygiene (lint, format, pre-commit hooks) compartidas por los proyectos de este repo.",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint poc-parser/src ui/src ui/vite.config.ts ui/vite-plugin-graph-editor.ts",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "poc-parser/src/**/*.ts": [
      "eslint --fix"
    ],
    "ui/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "ui/{vite.config.ts,vite-plugin-graph-editor.ts}": [
      "eslint --fix"
    ],
    "**/*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
